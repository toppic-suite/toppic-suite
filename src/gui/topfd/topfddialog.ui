        </property>
        <property name="acceptDrops">
         <bool>false</bool>
        </property>
        <property name="toolTip">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Filter the fragment ion envelopes of each MS/MS spectrum based on the estimated number of fragment ions: the envelopes ranked highest are kept (by the EnvCNN score, or by the MS-Deconv score with &quot;Sort using MS-Deconv score&quot; checked). Used with the greedy and msdeconv MS2 deconvolution methods, not with flashdeconv. Default: unchecked. (topfd -j, --frag-num-filtering)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Enable frag num-based filtering</string>
