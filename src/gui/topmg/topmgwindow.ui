          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Allow the protein N-terminal form NME: N-terminal methionine excision. At least one N-terminal form must be checked; all four are checked by default. (topmg -n, --n-terminal-form)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
