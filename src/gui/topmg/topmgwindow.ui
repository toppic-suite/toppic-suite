     <widget class="QGroupBox" name="groupBox_3">
      <property name="geometry">
       <rect>
        <x>10</x>
        <y>260</y>
        <width>861</width>
        <height>101</height>
       </rect>
      </property>
      <property name="title">
       <string>Cutoff settings</string>
      </property>
      <widget class="QLabel" name="label_11">
       <property name="geometry">
        <rect>
         <x>10</x>
         <y>25</y>
         <width>91</width>
         <height>41</height>
        </rect>
       </property>
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Spectrum-level cutoff: a PrSM is reported if its E-value (EVALUE) or spectrum-level FDR (FDR, needs Decoy database) is at most the value. Default: EVALUE, 0.01. (topmg -t, --spectrum-cutoff-type and -v, --spectrum-cutoff-value)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="text">
        <string>Spectrum
level:</string>
       </property>
      </widget>
      <widget class="QLabel" name="label_13">
       <property name="geometry">
        <rect>
         <x>300</x>
         <y>25</y>
         <width>91</width>
         <height>41</height>
        </rect>
       </property>
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Proteoform-level cutoff: a proteoform is reported if the E-value (EVALUE) or proteoform-level FDR (FDR, needs Decoy database) of its best PrSM is at most the value. Default: EVALUE, 0.01. (topmg -T, --proteoform-cutoff-type and -V, --proteoform-cutoff-value)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
