          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Keep the intermediate files (_ms2.topmg_* and _ms2.msalign_*) instead of deleting them at the end of the run; the _ms2.topmg_raw_prsm file is always kept. Default: off. (topmg -k, --keep-temp-files)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="text">
          <string>Keep intermediate files</string>
         </property>
