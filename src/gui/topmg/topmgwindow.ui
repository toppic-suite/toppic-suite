       </rect>
      </property>
      <layout class="QVBoxLayout" name="verticalLayout_3">
       <item>
        <widget class="QCheckBox" name="decoyCheckBox">
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Also search a shuffled decoy protein database to estimate false discovery rates. Needed for the FDR cutoff types, and cannot be unchecked while one is selected. Default: off. (topmg -d, --decoy)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="text">
          <string>Decoy database</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="wholeProteinCheckBox">
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Identify only proteoforms of whole proteins, that is, allow the proteoform type COMPLETE alone, without truncated (prefix, suffix or internal) proteoforms. Default: off. (topmg -w, --whole-protein-only)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="text">
          <string>Whole proteins only</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="topfdFeatureCheckBox">
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Check when the TopFD feature file of a spectrum file (_ms2.feature in the same folder) is missing: TopMG then runs without it and clusters PrSMs into proteoforms by protein, precursor mass and sequence overlap instead of by feature. Unchecked, a missing feature file is an error. Default: off. (topmg -x, --no-topfd-feature)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="text">
          <string>No TopFD feature file</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
